#!/usr/bin/env bash
set -euo pipefail

timestamp="$(date '+%Y-%m-%dT%H:%M:%S')"
updated=0

staged_posts="$(git diff --cached --name-only --diff-filter=ACM -- 'docs/_posts/*.md')"
staged_agentic_workflows="$(git diff --cached --name-only --diff-filter=ACM -- '.github/workflows/*.md')"
staged_me_changes="$(git diff --cached --name-only --diff-filter=ACMRD -- 'docs/assets/images/me')"
staged_speaking_photos="$(printf '%s\n' "$staged_me_changes" | grep -Ev '^docs/assets/images/me/(display|thumbs)/' || true)"
staged_speaking_photo_script="$(git diff --cached --name-only --diff-filter=ACM -- '.github/skills/speaking-photos/scripts/sync.ps1')"
staged_speaking_photo_validator="$(git diff --cached --name-only --diff-filter=ACM -- '.github/skills/speaking-photos/scripts/validate-gallery.rb')"
staged_speaking_page="$(git diff --cached --name-only --diff-filter=ACM -- 'docs/_pages/speaking.md')"

if [ -z "$staged_posts" ] && [ -z "$staged_agentic_workflows" ] && [ -z "$staged_speaking_photos" ] && [ -z "$staged_speaking_photo_script" ] && [ -z "$staged_speaking_photo_validator" ] && [ -z "$staged_speaking_page" ]; then
  exit 0
fi

if [ -n "$staged_speaking_photos" ] || [ -n "$staged_speaking_photo_script" ]; then
  if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh is required to generate speaking photo assets." >&2
    exit 1
  fi

  while IFS= read -r file; do
    [ -n "$file" ] || continue

    if ! git diff --quiet -- "$file"; then
      echo "pre-commit: $file has unstaged changes." >&2
      echo "pre-commit: stage or stash them before generating speaking photo assets." >&2
      exit 1
    fi
  done <<< "$staged_speaking_photos"

  if [ -n "$staged_speaking_photo_script" ] && ! git diff --quiet -- '.github/skills/speaking-photos/scripts/sync.ps1'; then
    echo "pre-commit: the speaking photo sync script has unstaged changes." >&2
    echo "pre-commit: stage or stash them before committing." >&2
    exit 1
  fi

  echo "pre-commit: syncing speaking photo assets"
  if [ -n "$staged_speaking_photo_script" ]; then
    pwsh -NoProfile -File '.github/skills/speaking-photos/scripts/sync.ps1' -Force
  else
    pwsh -NoProfile -File '.github/skills/speaking-photos/scripts/sync.ps1'
  fi

  git add -A -- \
    'docs/assets/images/me/display' \
    'docs/assets/images/me/thumbs' \
    'docs/_data/speaking_photos.json'
  echo "pre-commit: staged speaking photo derivatives and manifest"
fi

if [ -n "$staged_speaking_page" ] || [ -n "$staged_speaking_photo_validator" ]; then
  if ! command -v ruby >/dev/null 2>&1; then
    echo "pre-commit: ruby is required to validate the Speaking gallery." >&2
    exit 1
  fi

  for file in $staged_speaking_page $staged_speaking_photo_validator; do
    [ -n "$file" ] || continue

    if ! git diff --quiet -- "$file"; then
      echo "pre-commit: $file has unstaged changes." >&2
      echo "pre-commit: stage or stash them before validating the Speaking gallery." >&2
      exit 1
    fi
  done

  echo "pre-commit: validating Speaking gallery configuration"
  ruby '.github/skills/speaking-photos/scripts/validate-gallery.rb'
fi

if [ -n "$staged_posts" ]; then
while IFS= read -r file; do
  [ -n "$file" ] || continue
  [ -f "$file" ] || continue

  if ! git diff --quiet -- "$file"; then
    echo "pre-commit: $file has unstaged changes." >&2
    echo "pre-commit: stage or stash them before committing so last_modified_at can be updated safely." >&2
    exit 1
  fi

  if [ "$(sed -n '1p' "$file")" != "---" ]; then
    echo "pre-commit: skipping $file because it does not start with YAML front matter." >&2
    continue
  fi

  tmp="$(mktemp)"

  awk -v ts="$timestamp" '
    NR == FNR {
      if (FNR == 1 && $0 == "---") {
        scan_front_matter = 1
        next
      }

      if (scan_front_matter && $0 == "---") {
        scan_front_matter = 0
        next
      }

      if (scan_front_matter && $0 ~ /^last_modified_at:/) {
        has_last_modified_at = 1
      }

      next
    }

    FNR == 1 {
      in_front_matter = 0
      updated = 0
    }

    FNR == 1 && $0 == "---" {
      in_front_matter = 1
      print
      next
    }

    in_front_matter && $0 == "---" {
      if (!has_last_modified_at) {
        print "last_modified_at: " ts
      }
      in_front_matter = 0
      print
      next
    }

    in_front_matter && $0 ~ /^last_modified_at:/ {
      if (!updated) {
        print "last_modified_at: " ts
        updated = 1
      }
      next
    }

    { print }
  ' "$file" "$file" > "$tmp"

  if ! cmp -s "$file" "$tmp"; then
    mv "$tmp" "$file"
    git add "$file"
    updated=1
    echo "pre-commit: updated last_modified_at in $file"
  else
    rm "$tmp"
  fi
done <<< "$staged_posts"

if [ "$updated" -eq 1 ]; then
  echo "pre-commit: staged updated last_modified_at values."
fi
fi

if [ -n "$staged_agentic_workflows" ]; then
  if ! command -v gh >/dev/null 2>&1; then
    echo "pre-commit: gh CLI is required to compile Agentic Workflow files." >&2
    exit 1
  fi

  if ! gh aw --help >/dev/null 2>&1; then
    echo "pre-commit: gh aw is required to compile Agentic Workflow files." >&2
    echo "pre-commit: install GitHub Agentic Workflows before committing workflow source changes." >&2
    exit 1
  fi

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ -f "$file" ] || continue

    if ! git diff --quiet -- "$file"; then
      echo "pre-commit: $file has unstaged changes." >&2
      echo "pre-commit: stage or stash them before compiling the Agentic Workflow lock file." >&2
      exit 1
    fi

    lock_file="${file%.md}.lock.yml"

    if [ -f "$lock_file" ] && ! git diff --quiet -- "$lock_file"; then
      echo "pre-commit: $lock_file has unstaged changes." >&2
      echo "pre-commit: stage or stash them before compiling from $file." >&2
      exit 1
    fi

    echo "pre-commit: compiling $file"
    gh aw compile "$file"

    if [ ! -f "$lock_file" ]; then
      echo "pre-commit: expected $lock_file after compiling $file, but it was not created." >&2
      exit 1
    fi

    git add "$file" "$lock_file"
    echo "pre-commit: staged $lock_file"
  done <<< "$staged_agentic_workflows"
fi
